{
  "name": "spectacular-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "A Claude Code plugin.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "format": "prettier --write --cache --cache-location .cache/prettier/cache.json . && oxlint --fix && eslint --fix --cache --cache-location .cache/eslint/ .",
    "format:check": "prettier --check --cache --cache-location .cache/prettier/cache.json .",
    "lint": "oxlint && eslint --cache --cache-location .cache/eslint/ .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@j178/prek": "0.5.11",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.94.0",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
