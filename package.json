{
    "name": "spectacular-plugin",
    "version": "0.1.0",
    "private": true,
    "description": "A Claude Code plugin.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "packageManager": "bun@1.4.3",
    "scripts": {
        "format": "prek run --all-files --group format",
        "lint": "prek run --all-files --group lint",
        "build": "bash scripts/build.sh",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --project unit",
        "test:integration": "vitest run --project integration",
        "coverage": "vitest run --project unit --coverage"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@j178/prek": "^0.5.10",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "24",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-oxlint": "^1.92.0",
        "jiti": "^2.7.0",
        "markdownlint-cli2": "^0.24.0",
        "oxlint": "^1.92.0",
        "prettier": "^3.9.10",
        "typescript": "6",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    }
}
